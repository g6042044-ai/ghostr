{
  "expo": {
    "name": "Ghostr",
    "slug": "whisper-app",
    "version": "1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0F14"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ghostr.app",
      "buildNumber": "9",
      "infoPlist": {
        "NSCameraUsageDescription": "Ghostr uses the camera so you can scan a contact's QR code to start an encrypted conversation, scan a safety number to verify a contact's identity, take a photo to send inside a conversation (for example, sharing a picture with a friend), and set or update your profile picture.",
        "NSMicrophoneUsageDescription": "Ghostr uses the microphone so you can make end-to-end encrypted voice calls with your contacts and record voice messages to send inside a conversation.",
        "NSPhotoLibraryUsageDescription": "Ghostr accesses your photo library when you choose to send an image inside a conversation, for example sharing a vacation picture with a friend, or when you select an image as your profile picture.",
        "NSPhotoLibraryAddUsageDescription": "Ghostr saves images to your photo library when you tap Save on a photo you received in a conversation, so you can keep it on your device.",
        "UIBackgroundModes": [
          "audio",
          "remote-notification"
        ],
        "CFBundleAllowMixedLocalizations": true
      },
      "entitlements": {
        "aps-environment": "production",
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "associatedDomains": [
        "applinks:theghostr.com"
      ]
    },
    "locales": {
      "ar": "./locales/ar.json",
      "de": "./locales/de.json",
      "en": "./locales/en.json",
      "es": "./locales/es.json",
      "fr": "./locales/fr.json",
      "it": "./locales/it.json",
      "ru": "./locales/ru.json",
      "ur": "./locales/ur.json"
    },
    "androidStatusBar": {
      "backgroundColor": "#0A0F14",
      "barStyle": "light-content"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0F14"
      },
      "package": "com.ghostr.app",
      "versionCode": 21,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.VIBRATE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_PHONE_CALL",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.WAKE_LOCK"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "theghostr.com",
              "pathPrefix": "/i"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "ghostr"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "buildToolsVersion": "36.0.0",
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon_nobg.png",
          "color": "#6C63FF",
          "sounds": [
            "./assets/sounds/incallmanager_ringback.mp3"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Ghostr uses the camera to scan QR codes for joining conversations and verifying contacts, to take photos you choose to send inside a conversation, and to set or update your profile picture."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Ghostr accesses your photos when you choose to send an image inside a conversation or set a profile picture.",
          "savePhotosPermission": "Ghostr saves images to your photo library when you tap Save on a photo received in a conversation.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ghostr accesses your photos when you choose to send an image inside a conversation or set a profile picture."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Ghostr uses the microphone for end-to-end encrypted voice calls and to record voice messages you send inside a conversation."
        }
      ],
      "expo-secure-store",
      "@mykin-ai/expo-audio-stream",
      "./plugins/withRingbackTone",
      "./plugins/withCallNotification",
      "./plugins/withInsistentRingtone",
      "./plugins/withSpeakerRoute",
      "./plugins/withLargeScreenCompat"
    ],
    "extra": {
      "eas": {
        "projectId": "ef1bbfeb-0938-4269-94b6-891e6f15053a"
      }
    },
    "scheme": "ghostr"
  }
}
