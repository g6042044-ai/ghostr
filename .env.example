# ============================================================================
# GHOSTR — variables d'environnement du client (Expo)
# ============================================================================
# Copier ce fichier en `.env` et renseigner les valeurs. `.env` n'est pas suivi
# par git. Toutes ces variables sont préfixées EXPO_PUBLIC_ : elles sont
# compilées dans le binaire et visibles de quiconque décompile l'app. Aucune
# n'est un secret, mais l'app publiée en dépend : ne jamais changer une valeur
# de production sans plan de compatibilité (voir plan_actions.md, contraintes
# permanentes). Les builds EAS lisent leurs valeurs dans eas.json, pas ici.

# URL du projet Supabase (https://<ref>.supabase.co). Lue par src/services/api.ts.
EXPO_PUBLIC_SUPABASE_URL=

# Clé anon Supabase (JWT public). Publique par conception : la sécurité repose
# sur les policies RLS et le chiffrement de bout en bout, pas sur cette clé.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Relais Cloudflare Worker devant le gateway OHTTP (src/services/relayTransport.ts).
EXPO_PUBLIC_RELAY_URL=

# Serveur SFU pour les appels (src/services/call1to1Service.ts).
EXPO_PUBLIC_SFU_URL=

# Gateway OHTTP sur Cloud Run. Sert aussi de secours si le relais est injoignable.
EXPO_PUBLIC_GATEWAY_URL=

# Relais d'entrée du double saut WebRTC sur Fly.io (src/services/webrtcService.ts).
# Sans lui, l'app avertit en développement et perd l'anonymisation des appels.
EXPO_PUBLIC_ENTRY_RELAY_URL=

# `true` en production. Déclaré dans eas.json ; le client ne le lit pas encore
# (voir ohttp-gateway/compute-fingerprint.js).
EXPO_PUBLIC_GATEWAY_PINNING_ENFORCED=

# Clé publique X25519 du push-proxy, base64 (src/services/pushNotificationService.ts).
# Si vide, l'app envoie des blobs aléatoires à la place des jetons chiffrés.
EXPO_PUBLIC_PUSH_PROXY_PUBLIC_KEY=
